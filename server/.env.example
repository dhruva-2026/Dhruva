# DHRUVA Server Environment Configuration Template
PORT=5000
NODE_ENV=development
JWT_SECRET=your-256-bit-production-secret-key-here
CLIENT_URL=http://localhost:5173

# PostgreSQL + pgvector Database Configuration
DATABASE_URL=postgresql://dhruva_user:dhruva_password@localhost:5432/dhruva_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=dhruva_db
PGUSER=dhruva_user
PGPASSWORD=dhruva_password
PG_MAX_POOL=20

# Storage & Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# Optional: External AI Provider Keys (for live LLM text generation)
GROQ_API_KEY=
GEMINI_API_KEY=
